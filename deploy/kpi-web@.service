# Веб-приложение клиента (своё приложение вместо мессенджера). Установка на сервере:
#   cp deploy/kpi-web@.service /etc/systemd/system/ && systemctl daemon-reload
#   systemctl enable --now kpi-web@demo     # порт — WEB_PORT в clients/demo/.env (по умолчанию 8101)
# Слушает только 127.0.0.1 — снаружи в него ходит Caddy (адрес клиента → reverse_proxy 127.0.0.1:<порт>).
# Защита (Адам 01.11): работает от отдельного пользователя alapa, а не root, и видит только свою папку /srv/alapa —
# даже если в приложении найдётся дыра, до остальных ботов, их баз и секретов ей не добраться. Писать может только в
# data/ (базы, папка 1С) и clients/ («🚀 Создать клиента»). После git на сервере: chown -R alapa:alapa /srv/alapa.
[Unit]
Description=KPI-приложение клиента %i
After=network-online.target
Wants=network-online.target

[Service]
User=alapa
Group=alapa
WorkingDirectory=/srv/alapa
ExecStart=/srv/alapa/venv/bin/python run.py %i --web
Restart=always
RestartSec=5
MemoryMax=200M
MemorySwapMax=100M
CPUQuota=25%
Environment=MALLOC_ARENA_MAX=2
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/srv/alapa/data /srv/alapa/clients
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
